def calculate_employee_bonus(salary: float, experience_years: int) -> float:
    """
    Функция рассчитывает премию сотрудника в зависимости от стажа работы:
    - Если стаж 3 года и более — начисляется премия 20% от оклада.
    - Если стаж менее 3 лет — премия составляет 5% от оклада.

    Параметры:
        salary (float): базовый оклад сотрудника в рублях
        experience_years (int): количество полных лет стажа

    Возвращает:
        float: сумма начисленной премии в рублях
    """
    # ИСПРАВЛЕНО: теперь условие соответствует заданию
    if experience_years >= 3:
        bonus_amount = salary * 0.20  # 20% для опытных сотрудников
    else:
        bonus_amount = salary * 0.05  # 5% для новичков

    return bonus_amount


# --- ТЕСТОВЫЙ БЛОК (для проверки работы модуля) ---
if __name__ == "__main__":
    test_salary = 50000
    test_experience = 5  # Опытный сотрудник (стаж 5 лет)
    expected_bonus = 10000.0  # 20% от 50 000 руб.

    print("--- ТЕСТИРОВАНИЕ МОДУЛЯ НАЧИСЛЕНИЯ ПРЕМИЙ ---")
    print(f"Оклад сотрудника: {test_salary} руб.")
    print(f"Стаж работы: {test_experience} лет")
    print(f"Ожидаемая сумма премии: {expected_bonus} руб. (20%)")

    # Вызов функции
    actual_bonus = calculate_employee_bonus(test_salary, test_experience)

    print(f"Фактическая сумма премии: {actual_bonus} руб.")

    if actual_bonus == expected_bonus:
        print("\n [УСПЕХ] Задание 3 выполнено! Условие начисления премии исправлено.")
    else:
        print("\n [ОШИБКА] Программа начислила неверную премию! Запустите отладчик (Debug F5).")

