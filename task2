def count_excellent_grades(grades_list: list) -> int:
    """
    Функция подсчитывает количество пятерок (отличных оценок) в журнале.
    
    Параметры:
        grades_list (list): список школьных оценок (числа от 2 до 5)
        
    Возвращает:
        int: итоговое количество пятерок
    """
    fives_counter = 0

    # Проходим по каждому элементу списка оценок
    for grade in grades_list:
        # ИСПРАВЛЕНО: было grade == 4, стало grade == 5
        if grade == 5:
            fives_counter += 1

    return fives_counter


# --- ТЕСТОВЫЙ БЛОК (для проверки работы модуля) ---
if __name__ == "__main__":
    # Список оценок студента за четверть
    sample_grades = [5, 4, 3, 5, 5, 4, 5]
