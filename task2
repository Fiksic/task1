    print("--- ТЕСТИРОВАНИЕ МОДУЛЯ ПОДСЧЕТА ОЦЕНОК ---")
    print(f"Список оценок: {sample_grades}")
    print(f"Ожидаемое количество пятерок: {expected_fives}")

    # Вызов функции
    actual_result = count_excellent_grades(sample_grades)

    print(f"Фактический результат работы программы: {actual_result}")

    if actual_result == expected_fives:
